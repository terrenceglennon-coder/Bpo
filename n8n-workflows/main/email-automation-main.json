    {
      "parameters": {
        "jsCode": "// PRE-FILTERING: Skip AI for obvious categories\nconst subject = $input.item.json.Subject || '';\nconst snippet = $input.item.json.snippet || '';\nconst from = $input.item.json.from?.value?.[0]?.address || '';\nconst combinedText = (subject + ' ' + snippet).toLowerCase();\n\n// Initialize result\nlet result = {\n  ....$input.item.json,\n  preFilterCategory: null,\n  skipAI: false,\n  cacheKey: null,\n  needsClassification: true\n};\n\n// 1. Check for LinkedIn (highest priority for LinkedIn)\nif (from.includes('linkedin.com') || combinedText.includes('linkedin')) {\n  result.preFilterCategory = 'Linkedin';\n  result.skipAI = true;\n  result.needsClassification = false;\n}\n// 2. Check for promotions\nelse if (\n  combinedText.match(/\\b(sale|discount|offer|promotion|deal|limited time|exclusive|buy now)\\b/)\n) {\n  result.preFilterCategory = 'Promotion';\n  result.skipAI = true;\n  result.needsClassification = false;\n}\n// 3. Check for out of office\nelse if (\n  combinedText.includes('out of office') ||\n  combinedText.includes('automatic reply') ||\n  combinedText.includes('away from my desk')\n) {\n  result.preFilterCategory = 'Ignore';\n  result.skipAI = true;\n  result.needsClassification = false;\n}\n// 4. Generate cache key for remaining emails\nelse {\n  // Create cache key: normalize text and hash it\n  const normalizedText = combinedText\n    .replace(/\\d+/g, 'NUM') // Replace numbers with NUM\n    .replace(/[^\\w\\s]/g, '') // Remove special characters\n    .substring(0, 100); // First 100 chars\n  \n  result.cacheKey = normalizedText;\n  result.needsClassification = true;\n}\n\n// Limit snippet to 200 chars to reduce tokens\nif (result.snippet && result.snippet.length > 200) {\n  result.snippet = result.snippet.substring(0, 200) + '...';\n}\n\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 400],
      "id": "pre-filter-node",
      "name": "Pre-Filter & Cache Key",
      "notes": "Skips AI for obvious categories (LinkedIn, Promotions, OOO)"
    },
    {
      "parameters": {
        "conditions": {
