        "categories": {
          "categories": [
            {
              "category": "Customer Support",
              "description": "Emails seeking help or guidance for using a product or service. These usually report problems like login issues, bugs, or functionality errors that aren't time-critical.\nExpanded Keywords: help, issue, support, error, reset, fix, login, troubleshoot, can't, question, not working"
            },
            {
              "category": "Finance/Billing",
              "description": "Emails related to payments, charges, invoices, or subscription details. The sender is usually requesting an update, refund, or correction.\nExpanded Keywords: invoice, refund, payment, billing, subscription, charge, receipt, overcharged, decline, failed transaction, cancel, renewal"
            },
            {
              "category": "High Priority",
              "description": "Emails marked by urgency or escalation, often involving outages, system failures, or time-critical issues that need immediate action.\nExpanded Keywords: urgent, ASAP, emergency, escalation, outage, down, broken, immediately, help now, fix fast"
            },
            {
              "category": "Promotion",
              "description": "Emails with promotional content offering discounts, product updates, or invitations to join or purchase something. These are sales-driven and often use upbeat language.\nExpanded Keywords: sale, discount, offer, promotion, upgrade, exclusive, feature, join now, limited time, access now, new launch"
            },
            {
              "category": "Family",
              "description": "Personal emails from family, friends, or close acquaintances. These messages are usually informal, emotional, or conversational and unrelated to business.\nExpanded Keywords: hi, hey, how are you, family, friend, catching up, love, miss you, birthday, update, just checking in, weekend, Mom, Dad\n\nFamily has president over all other categories "
            },
            {
              "category": "Uncategorized",
              "description": "Emails that don't clearly fit any of the defined categories. These may be vague, irrelevant, or unclassified messages. Keywords: N/A"
            },
            {
              "category": "Linkedin",
              "description": "Emails from LinkedIn, including job alerts, connection suggestions, profile updates, and platform notifications. Occasionally includes direct messages from other users.  Common keywords: LinkedIn, job alert, opportunity, connection, message, recruiter, profile, network, hiring, suggested, update, post, invite\nIf it has the word LinkedIn classify as LinkedIn over any other "
            }
          ]
        },
        "options": {}
      },
