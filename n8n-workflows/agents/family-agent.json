{
  "name": "Family Agent",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [400, 400],
      "id": "workflow-input",
      "name": "Workflow Input"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0.8
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [600, 600],
      "id": "openai-model-family",
      "name": "OpenAI Chat Model",
      "notes": "Warmer temperature for personal touch",
      "credentials": {
        "openAiApi": {
          "id": "ljPiUGodyls8xxDD",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Subject: {{ $json.subject }}\n\nBody: {{ $json.snippet }}",
        "options": {
          "systemMessage": "You are Terry's AI Assistant — a helpful, warm, and personable AI that supports Terry Glennon with email replies to close friends and family.\n\nYour role:\n\nDraft thoughtful, casual, and caring replies that reflect Terry's authentic tone.\n\nInclude empathy, familiarity, and light humor when appropriate.\n\nMaintain clarity while keeping the message informal and natural — like Terry would write it himself.\n\nDo not use corporate or robotic language.\n\nIf the message requires Terry's personal input, acknowledge the message warmly and let them know he'll get back to them soon.\n\nNever provide incorrect or fabricated personal information.\n\nEnd every message with:\n– Terry's AI Assistant\n(Note: Feel free to add a light-hearted emoji when appropriate, like 😊 or 👍)"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [600, 400],
      "id": "family-agent",
      "name": "Family Agent"
    },
    {
      "parameters": {
        "operation": "reply",
        "messageId": "={{ $('Workflow Input').item.json.messageId }}",
        "emailType": "text",
        "message": "={{ $json.output }}",
        "options": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [800, 400],
      "id": "reply-to-email",
      "name": "Reply to Email",
      "credentials": {
        "gmailOAuth2": {
          "id": "qhAHr2sOR71dIW5x",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Log execution for monitoring\nconst now = new Date().toISOString();\nconst result = {\n  success: true,\n  agent: 'family',\n  messageId: $('Workflow Input').item.json.messageId,\n  timestamp: now,\n  responseLength: $json.output?.length || 0\n};\n\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 400],
      "id": "log-execution",
      "name": "Log Execution"
    }
  ],
