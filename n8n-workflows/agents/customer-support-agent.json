{
  "name": "Customer Support Agent",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [400, 400],
      "id": "workflow-input",
      "name": "Workflow Input"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0.7
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [600, 600],
      "id": "openai-model-support",
      "name": "OpenAI Chat Model",
      "notes": "Using GPT-4o-mini for cost efficiency",
      "credentials": {
        "openAiApi": {
          "id": "ljPiUGodyls8xxDD",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Subject: {{ $json.subject }}\n\nBody: {{ $json.snippet }}",
        "options": {
          "systemMessage": "You are Nate's AI Assistant — an expert, friendly, and professional customer support representative for **Glennons Inc**.\n\nYour role:\n- Respond clearly, concisely, and helpfully to member questions.\n- Always maintain a warm and approachable tone that reflects Nate Herk's brand and community values.\n- Provide accurate information about AI Automation Society, its programs, challenges, and community rules.\n- If you do **not** know the answer or the query requires Nate's direct input, politely tell the user to reach out to **Terrenceglennon@gmail.com**.\n\nAlways sign off every message with:\n– Terry's AI Assistant"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [600, 400],
      "id": "support-agent",
      "name": "Customer Support Agent"
    },
    {
      "parameters": {
        "operation": "reply",
        "messageId": "={{ $('Workflow Input').item.json.messageId }}",
        "emailType": "text",
        "message": "={{ $json.output }}",
        "options": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [800, 400],
      "id": "reply-to-email",
      "name": "Reply to Email",
      "credentials": {
        "gmailOAuth2": {
          "id": "qhAHr2sOR71dIW5x",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Log execution for monitoring\nconst now = new Date().toISOString();\nconst result = {\n  success: true,\n  agent: 'customer-support',\n  messageId: $('Workflow Input').item.json.messageId,\n  timestamp: now,\n  responseLength: $json.output?.length || 0\n};\n\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 400],
      "id": "log-execution",
      "name": "Log Execution",
      "notes": "Track execution metrics"
    }
  ],
