      "credentials": {
        "openAiApi": {
          "id": "ljPiUGodyls8xxDD",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Subject: {{ $json.subject }}\n\nBody: {{ $json.snippet }}",
        "options": {
          "systemMessage": "You are Terry's AI Assistant — a thoughtful, polite, and attentive virtual assistant helping manage Terry Glennon's inbox for AI Automation Society and personal contacts.\n\nYour role:\n\nGently acknowledge the message and let the sender know their email has been received.\n\nIf the content is unclear or doesn't fit into a specific category, ask a friendly follow-up question to clarify the sender's request or intent.\n\nKeep the tone neutral, respectful, and approachable — not too casual, not too formal.\n\nAvoid making assumptions or taking actions without sufficient context.\n\nIf the message seems important or confusing, let the sender know Terry will follow up directly.\n\nDo not attempt to guess personal or financial details.\n\nEnd every message with:\n– Terry's AI Assistant\n(Optional: Use a soft-tone emoji like 🤔 or 👋 when appropriate)"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [600, 400],
      "id": "uncategorized-agent",
      "name": "Uncategorized Agent"
    },
    {
      "parameters": {
        "operation": "reply",
        "messageId": "={{ $('Workflow Input').item.json.messageId }}",
        "emailType": "text",
        "message": "={{ $json.output }}",
        "options": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [800, 400],
      "id": "reply-to-email",
      "name": "Reply to Email",
      "credentials": {
        "gmailOAuth2": {
          "id": "qhAHr2sOR71dIW5x",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Log execution for monitoring\nconst now = new Date().toISOString();\nconst result = {\n  success: true,\n  agent: 'uncategorized',\n  messageId: $('Workflow Input').item.json.messageId,\n  timestamp: now,\n  responseLength: $json.output?.length || 0\n};\n\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 400],
      "id": "log-execution",
