# 5 Whys RCA Workflow - Environment Variables
# Copy this file to .env and fill in your actual values

# ===================================
# REQUIRED CONFIGURATION
# ===================================

# Google Sheets Configuration
GOOGLE_SHEET_ID=your_google_sheet_id_here
# Example: 1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms
# Get this from your Google Sheet URL

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Example: sk-ant-api03-xxxxx
# Get from: https://console.anthropic.com/

# Telegram Bot Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Example: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# Get from @BotFather on Telegram

# ===================================
# OPTIONAL CONFIGURATION (with defaults)
# ===================================

# Claude Model Selection
# Options: claude-sonnet-4-20250514, claude-opus-4-20250514, claude-haiku-4-20250514
CLAUDE_MODEL=claude-sonnet-4-20250514

# User Response Timeout (in milliseconds)
# Default: 3600000 (1 hour)
# Examples:
#   - 1800000 = 30 minutes
#   - 3600000 = 1 hour
#   - 7200000 = 2 hours
USER_RESPONSE_TIMEOUT=3600000

# Maximum API Retry Attempts
# Default: 3
# How many times to retry failed API calls
MAX_API_RETRIES=3

# Anthropic API URL
# Default: https://api.anthropic.com/v1/messages
# Only change if using a proxy or different endpoint
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages

# Google Sheets API Settings
# Enable/disable Google Sheets integration
GOOGLE_SHEETS_ENABLED=true

# ===================================
# ADVANCED CONFIGURATION
# ===================================

# Session Timeout (hours)
# How long to keep inactive sessions alive
SESSION_TIMEOUT_HOURS=24

# Data Quality Thresholds
# Minimum characters for validation
MIN_PROBLEM_STATEMENT_LENGTH=20
MIN_INITIAL_ANSWER_LENGTH=10
MIN_DATA_GATHERED_LENGTH=20
MIN_VALIDATED_ANSWER_LENGTH=10

# Quality Scoring
# Minimum data gathered length for "Excellent" rating
EXCELLENT_DATA_LENGTH=50

# Retry Delays (milliseconds)
# Exponential backoff delays: delay * (2 ^ attempt)
INITIAL_RETRY_DELAY=2000

# Notification Settings
SEND_TIMEOUT_NOTIFICATIONS=true
SEND_QUALITY_FEEDBACK=true
SEND_PROGRESS_UPDATES=true

# Logging Level
# Options: debug, info, warn, error
LOG_LEVEL=info

# ===================================
# FEATURE FLAGS
# ===================================

# Enable/disable specific features
ENABLE_STATUS_COMMAND=true
ENABLE_CANCEL_COMMAND=true
ENABLE_HELP_COMMAND=true
ENABLE_DATA_VALIDATION=true
ENABLE_QUALITY_SCORING=true
ENABLE_AUTO_RETRY=true

# ===================================
# INTEGRATION SETTINGS (Future)
# ===================================

# Slack Integration (Future)
# SLACK_WEBHOOK_URL=
# SLACK_CHANNEL=#rca-reports

# Email Notifications (Future)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# NOTIFICATION_EMAIL=

# JIRA Integration (Future)
# JIRA_URL=
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=

# ===================================
# NOTES
# ===================================

# 1. Never commit .env file to version control
# 2. Keep your API keys secret
# 3. Rotate keys regularly
# 4. Use environment-specific values (dev, staging, prod)
# 5. Grant minimum required permissions

# ===================================
# QUICK START
# ===================================

# 1. Copy this file:
#    cp .env.example .env

# 2. Fill in required values:
#    - GOOGLE_SHEET_ID
#    - ANTHROPIC_API_KEY
#    - TELEGRAM_BOT_TOKEN

# 3. (Optional) Customize timeouts and thresholds

# 4. Load in n8n:
#    - Settings > Environment Variables
#    - Import from .env file
#    OR
#    - Set manually in n8n UI

# 5. Test workflow:
#    - Send /help to your Telegram bot
#    - Try /start5whys TEST-001
